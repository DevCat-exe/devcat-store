# Copy this file to .env for local development.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Set a private password of at least 16 characters.
ADMIN_PASSWORD=replace-with-a-private-password-at-least-16-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional: higher GitHub API rate limits for release sync.
GITHUB_TOKEN=
