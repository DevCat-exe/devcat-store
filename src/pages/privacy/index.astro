---
import Header from "../../components/Header.astro";
import { getApps, type AppRecord } from "../../lib/apps";
import "../../styles/global.css";

let apps: AppRecord[] = [];
let catalogError = "";
try {
  apps = await getApps();
} catch (error) {
  console.error("Unable to load the Devcat privacy hub:", error);
  Astro.response.status = 503;
  catalogError = "Privacy information is temporarily unavailable. Please try again shortly.";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Find privacy policies for Devcat apps." />
    <meta name="theme-color" content="#f7f8f6" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Privacy hub — Devcat</title>
  </head>
  <body>
    <Header currentPath="/privacy" />
    <main class="privacy-main">
      <section class="page-intro">
        <span class="eyebrow"><span class="eyebrow-dot"></span> Privacy hub</span>
        <h1>Privacy information, <span>all in one place.</span></h1>
        <p>Choose an app to read its published privacy policy and find its source repository.</p>
      </section>
      {
        catalogError ? (
          <div class="catalog-alert" role="alert">{catalogError}</div>
        ) : apps.length ? (
          <ul class="privacy-app-list">
            {apps.map((app) => (
              <li>
                <a class="privacy-app-link" href={`/privacy/${app.slug}`}>
                  <span class="privacy-app-mark">{app.name.slice(0, 1)}</span>
                  <span class="privacy-app-copy"><strong>{app.name}</strong><small>{app.privacyPolicy ? "Privacy policy available" : "Policy not published yet"}</small></span>
                  <span class="privacy-app-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-state">No apps have been published yet.</div>
        )
      }
    </main>
    <footer class="site-footer"><div class="site-footer-inner"><a class="brand" href="/"><span class="brand-mark">D</span><span>Devcat<span class="brand-dot">.</span></span></a><p>Privacy should be easy to find.</p><a href="/apps">All apps</a></div></footer>
  </body>
</html>
