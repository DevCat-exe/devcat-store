---
import { Expand } from "@lucide/astro";

export interface Props {
  screenshots: string[];
  appName: string;
}

const { screenshots, appName } = Astro.props;
---

{
  screenshots.length > 0 && (
    <section class="screenshot-section" aria-label={`${appName} screenshots`}>
      <div class="section-heading">
        <div>
          <span class="eyebrow">A look inside</span>
          <h2>Made to feel familiar.</h2>
        </div>
        <p>Select a screenshot to view it larger.</p>
      </div>
      <div class="screenshot-rail">
        {screenshots.map((screenshot, index) => (
          <button
            class="screenshot-button"
            type="button"
            data-full-image={screenshot}
            data-image-alt={`${appName} screenshot ${index + 1}`}
            aria-label={`View screenshot ${index + 1} larger`}
          >
            <img src={screenshot} alt={`${appName} screen ${index + 1}`} loading="lazy" />
            <span><Expand class="size-4" aria-hidden="true" /> View</span>
          </button>
        ))}
      </div>
      <dialog class="screenshot-dialog" aria-label={`${appName} screenshot viewer`}>
        <button class="dialog-close" type="button" aria-label="Close screenshot">×</button>
        <img src="" alt="" />
      </dialog>
      <script>
        const dialog = document.querySelector<HTMLDialogElement>(".screenshot-dialog");
        const dialogImage = dialog?.querySelector("img");
        const closeButton = dialog?.querySelector<HTMLButtonElement>(".dialog-close");

        document.querySelectorAll<HTMLButtonElement>(".screenshot-button").forEach((button) => {
          button.addEventListener("click", () => {
            if (!dialog || !dialogImage) return;
            dialogImage.src = button.dataset.fullImage ?? "";
            dialogImage.alt = button.dataset.imageAlt ?? "";
            dialog.showModal();
          });
        });

        closeButton?.addEventListener("click", () => dialog?.close());
        dialog?.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      </script>
    </section>
  )
}
